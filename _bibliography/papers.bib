@article{cornelissen2026lafreewm,
  abbr={Preprint},
  title={LaFree World Model: Label-Efficient Latent Action Inference for JEPA World Models},
  author={Cornelissen, Ciem and Leroux, Sam and Simoens, Pieter},
  journal={Preprint},
  year={2026},
  abstract={JEPA-style world models learn latent dynamics from pixels, but typically require action labels for every training trajectory. LaFreeWM replaces labeled action conditioning during world-model pretraining with discrete latent actions inferred from consecutive encoded observations. A small labeled subset then grounds the pretrained predictor in raw actions for planning. Across four benchmarks and both 1\% and 10\% label budgets, LaFreeWM outperforms label-matched LeWM in every environment and exposes a prediction--planning mismatch in which better observational prediction does not imply better control.},
  bibtex_show={true},
  selected={true},
  pdf={LaFreeWM_Preprint.pdf},
  preview={lafreewm_paper.png}
}

@inproceedings{cornelissen2026lemumojepa,
  abbr={CVPR},
  title={Le MuMo JEPA: Multi-Modal Self-Supervised Representation Learning with Learnable Fusion Tokens},
  author={Cornelissen, Ciem and Leroux, Sam and Simoens, Pieter},
  booktitle={IEEE/CVF Conference on Computer Vision and Pattern Recognition (CVPR) Workshops - URVIS},
  year={2026},
  abstract={A self-supervised framework that learns unified representations from RGB images and aligned companion modalities. Extends LeJEPA to the multi-modal setting by learning fusion tokens that act as a latent bottleneck between modality-specific patch stems inside a shared transformer. Evaluated on Waymo, nuScenes, and RGB-thermal FLIR benchmarks, demonstrating strong performance-efficiency trade-offs for detection, depth estimation, and segmentation.},
  bibtex_show={true},
  selected={true},
  pdf={openreview_combined.pdf},
  preview={lemumojepa_paper.png}
}

